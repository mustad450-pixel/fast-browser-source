+.widget-menu button:hover, .widget-menu button:focus-visible { background: rgba(127,127,127,.16); filter: none; }
+.widget-menu-separator { height: 1px; margin: 5px 4px; background: var(--border); }
+.widget-menu button.is-current::after { content: "✓"; float: right; color: var(--muted); }
+.widget.drag-armed { border-color: rgba(255,255,255,.30); }
