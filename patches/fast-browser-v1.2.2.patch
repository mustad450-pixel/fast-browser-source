+.dialog-form label { display: grid; gap: 5px; }
+.dialog-actions { display: flex; justify-content: flex-end; gap: 8px; }
+@media (max-width: 900px) { .widget.size-small, .widget.size-medium, .widget.size-large { grid-column: span 6; } }
+@media (max-width: 600px) {
+  .shell { width: min(100% - 24px, 1180px); }
