+}
+
+body[data-user-text-color="true"]
+.widget[data-widget="tasks"] input::placeholder {
+  color: var(--muted);
+}
+/* Fast Browser: hide Weather card bottom border */
+.widget[data-widget="weather"] {
+  border-bottom-color: transparent;
+}
