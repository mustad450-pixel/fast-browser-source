+//
+// Fast Browser: per-tab active usage timer
+//
+
+int Tab::GetFastBrowserUsageTimerMode() const {
+  BrowserWindowInterface* const browser_window_interface =
+      controller_->GetBrowserWindowInterface();
+
+  if (!browser_window_interface ||
+      !browser_window_interface->GetProfile()) {
+    return 0;
+  }
+
+  const int mode =
+      browser_window_interface->GetProfile()->GetPrefs()->GetInteger(
+          prefs::kFastBrowserTabUsageTimerMode);
+
+  return mode >= 0 && mode <= 2 ? mode : 0;
+}
+
+std::u16string Tab::GetFastBrowserUsageDisplayTitle() const {
+  // Initialised when the first tab title is rendered, effectively marking
+  // the beginning of this Fast Browser process/session.
+  static const base::TimeTicks fast_browser_session_start =
+      base::TimeTicks::Now();
+
+  std::u16string title = data_.title;
+
+  if (data_.should_render_loading_title) {
+    title = icon_->GetShowingLoadingAnimation()
+                ? l10n_util::GetStringUTF16(IDS_TAB_LOADING_TITLE)
+                : CoreTabHelper::GetDefaultTitle();
+  } else {
+    title = WindowMetadataController::FormatTitleForDisplay(title);
+  }
+
+  const int mode = GetFastBrowserUsageTimerMode();
+
+  if (mode == 0) {
+    return title;
+  }
+
+  base::TimeDelta display_time;
+
+  if (mode == 2) {
+    display_time =
+        base::TimeTicks::Now() - fast_browser_session_start;
+  } else {
+    display_time = fast_browser_active_time_;
+  }
+
+  const auto total_minutes = display_time.InMinutes();
+  const auto hours = total_minutes / 60;
+  const auto minutes = total_minutes % 60;
+
+  std::u16string hours_text =
+      base::NumberToString16(hours);
+
+  std::u16string minutes_text =
+      base::NumberToString16(minutes);
+
+  if (hours_text.size() < 2) {
+    hours_text.insert(hours_text.begin(), u'0');
+  }
+
+  if (minutes_text.size() < 2) {
+    minutes_text.insert(minutes_text.begin(), u'0');
+  }
+
+  if (!title.empty()) {
+    title.append(u"  ");
+  }
+
+  title.append(hours_text);
+  title.append(u":");
+  title.append(minutes_text);
+
+  return title;
+}
+
+void Tab::UpdateFastBrowserUsageTimerTitle() {
+  const std::u16string title =
+      GetFastBrowserUsageDisplayTitle();
+
+  if (title_->GetText() != title) {
+    title_->SetText(title);
+    TooltipTextChanged();
+  }
+}
+
+void Tab::OnFastBrowserUsageTimerTick() {
+  const int mode = GetFastBrowserUsageTimerMode();
+  const base::TimeTicks now = base::TimeTicks::Now();
+
+  if (mode == 1 &&
+      !fast_browser_last_tick_.is_null() &&
+      IsActive() &&
+      GetWidget() &&
+      GetWidget()->IsActive()) {
+    fast_browser_active_time_ +=
+        now - fast_browser_last_tick_;
+  }
+
+  fast_browser_last_tick_ = now;
+
+  UpdateFastBrowserUsageTimerTitle();
+  UpdateFastBrowserUsageTimerState();
+}
+
+void Tab::UpdateFastBrowserUsageTimerState() {
+  const int mode = GetFastBrowserUsageTimerMode();
+
+  const bool should_run =
+      mode == 2 || (mode == 1 && IsActive());
+
+  if (should_run) {
+    if (!fast_browser_usage_timer_.IsRunning()) {
+      fast_browser_last_tick_ = base::TimeTicks::Now();
+
+      fast_browser_usage_timer_.Start(
+          FROM_HERE,
+          base::Seconds(1),
+          this,
+          &Tab::OnFastBrowserUsageTimerTick);
+    }
+  } else {
+    fast_browser_usage_timer_.Stop();
+    fast_browser_last_tick_ = base::TimeTicks();
+  }
+}
+
+void Tab::OnFastBrowserUsageTimerPrefChanged() {
+  UpdateFastBrowserUsageTimerState();
+  UpdateFastBrowserUsageTimerTitle();
+}
