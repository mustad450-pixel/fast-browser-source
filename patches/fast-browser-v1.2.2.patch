+void AboutHandler::HandleFastBrowserCheckForUpdate(
+    const base::ListValue& args) {
+  base::FilePath local_app_data;
+  base::FilePath system_dir;
+  if (!base::PathService::Get(base::DIR_LOCAL_APP_DATA, &local_app_data) ||
+      !base::PathService::Get(base::DIR_SYSTEM, &system_dir)) {
+    return;
+  }
+
+  const base::FilePath updater =
+      local_app_data.Append(L"Fast Sector")
+          .Append(L"Fast Browser")
+          .Append(L"Updater")
+          .Append(L"FastBrowserUpdater.ps1");
+  const base::FilePath powershell =
+      system_dir.Append(L"WindowsPowerShell")
+          .Append(L"v1.0")
+          .Append(L"powershell.exe");
+
+  if (!base::PathExists(updater) || !base::PathExists(powershell)) {
+    return;
+  }
+
+  base::CommandLine command(powershell);
+  command.AppendArg("-NoProfile");
+  command.AppendArg("-NonInteractive");
+  command.AppendArg("-ExecutionPolicy");
+  command.AppendArg("Bypass");
+  command.AppendArg("-WindowStyle");
+  command.AppendArg("Hidden");
+  command.AppendArg("-File");
+  command.AppendArgPath(updater);
+  command.AppendArg("-Interactive");
+
+  base::LaunchOptions options;
+  options.start_hidden = true;
+  (void)base::LaunchProcess(command, options);
