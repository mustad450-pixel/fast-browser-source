+body[data-user-text-color="true"] .widget[data-widget="tasks"] .widget-head,
+body[data-user-text-color="true"] .widget[data-widget="tasks"] .task-label,
+body[data-user-text-color="true"] .widget[data-widget="tasks"] input {
