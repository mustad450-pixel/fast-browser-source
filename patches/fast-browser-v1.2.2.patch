diff --git a/chrome/browser/extensions/component_loader.cc b/chrome/browser/extensions/component_loader.cc
index 80927be5adaa7dac216aabc1cb8644e0edd44d9d..ccb5d0338f599af684ed606080db0703f1438d3e 100644
--- a/chrome/browser/extensions/component_loader.cc
+++ b/chrome/browser/extensions/component_loader.cc
@@ -695,6 +695,19 @@ void ComponentLoader::AddDefaultComponentExtensions(
 #endif  // BUILDFLAG(ENABLE_PDF)
   }
 
+  // FAST_BROWSER_START_HUB_BEGIN
+#if BUILDFLAG(IS_WIN)
+  // Fast Browser ships its Start Hub as a local component extension under
+  // chrome::DIR_RESOURCES so users do not need to load it manually.
+  base::FilePath fast_start_hub_dir;
+  if (base::PathService::Get(chrome::DIR_RESOURCES, &fast_start_hub_dir)) {
+    fast_start_hub_dir = fast_start_hub_dir.AppendASCII("fast_start_hub");
+    if (base::DirectoryExists(fast_start_hub_dir)) {
+      AddOrReplace(fast_start_hub_dir);
+    }
+  }
+#endif  // BUILDFLAG(IS_WIN)
+  // FAST_BROWSER_START_HUB_END
   AddDefaultComponentExtensionsWithBackgroundPages(skip_session_components);
 }
 
