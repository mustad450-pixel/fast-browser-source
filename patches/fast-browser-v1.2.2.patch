+.task-cleanup { margin-top: 10px; }
+.count-badge { display: inline-flex; min-width: 20px; height: 20px; align-items: center; justify-content: center; margin-left: 6px; padding: 0 6px; border-radius: 999px; background: rgba(127,127,127,.16); color: var(--muted); font-size: 11px; }
