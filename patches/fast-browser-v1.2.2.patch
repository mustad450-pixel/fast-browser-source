+.widget-menu {
+  position: fixed; z-index: 60; min-width: 182px; padding: 7px; border-radius: 13px;
+  background: #171d23; color: #f2f5f7; border: 1px solid rgba(255,255,255,.14);
+  box-shadow: 0 18px 50px rgba(0,0,0,.42);
