+.world-time { font-size: 20px; font-weight: 550; font-variant-numeric: tabular-nums; }
+.focus-wrap { display: grid; justify-items: center; gap: 13px; padding-top: 4px; }
+.focus-time { font-size: 43px; font-variant-numeric: tabular-nums; font-weight: 280; }
+.focus-controls { display: flex; gap: 8px; }
+.focus-progress { width: min(220px, 85%); height: 4px; overflow: hidden; border-radius: 99px; background: rgba(127,127,127,.18); }
+.focus-progress span { display: block; height: 100%; width: 0; background: currentColor; opacity: .72; border-radius: inherit; }
+.weather-data { display: flex; justify-content: space-between; gap: 18px; align-items: end; }
+.weather-primary { display: flex; align-items: center; gap: 12px; }
+.weather-icon { width: 46px; height: 46px; display: grid; place-items: center; font-size: 34px; }
+.weather-temp { font-size: 49px; font-weight: 280; line-height: 1; }
+.weather-meta { display: flex; flex-direction: column; gap: 4px; text-align: right; }
+.empty-state { display: grid; gap: 9px; justify-items: start; color: var(--muted); }
+.weather-symbol { font-size: 34px; }
+.settings-panel { position: fixed; z-index: 20; top: 16px; right: 16px; width: min(390px, calc(100vw - 32px)); max-height: calc(100vh - 32px); overflow: auto; background: var(--panel-strong); color: var(--text); border: 1px solid var(--border); border-radius: 20px; box-shadow: 0 24px 80px rgba(0,0,0,.36); padding: 18px; backdrop-filter: blur(24px); }
+.settings-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px; }
+.panel-close { font-size: 24px; }
+.setting-section { border-top: 1px solid var(--border); padding-top: 14px; margin-top: 14px; }
+.setting-section.first { border-top: 0; margin-top: 5px; }
+.setting-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 10px; }
+.toggle-list { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 10px; }
+.toggle-item { display: flex; align-items: center; gap: 8px; }
+.size-controls { display: grid; gap: 8px; margin-top: 10px; }
+.size-row { display: grid; grid-template-columns: 1fr auto; gap: 10px; align-items: center; }
+.number-input { width: 78px; }
+.privacy-note { margin-top: 8px; color: var(--muted); font-size: 12px; line-height: 1.45; }
+.wide-button { width: 100%; margin-top: 12px; }
+.button-row { display: flex; gap: 8px; margin-top: 10px; }
+dialog { border: 1px solid var(--border); border-radius: 18px; background: var(--panel-strong); color: var(--text); box-shadow: var(--shadow); }
+dialog::backdrop { background: rgba(0,0,0,.45); backdrop-filter: blur(4px); }
+.dialog-form { width: min(420px, 78vw); display: grid; gap: 12px; }
