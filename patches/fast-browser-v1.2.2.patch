@@ -0,0 +1,23 @@
+{
+  "manifest_version": 3,
+  "name": "Fast Start Hub",
+  "version": "0.5.1",
+  "description": "Built-in Fast Browser Start Hub by Fast Sector.",
+  "permissions": [
+    "search"
+  ],
+  "host_permissions": [
+    "https://geocoding-api.open-meteo.com/*",
+    "https://api.open-meteo.com/*"
+  ],
+  "chrome_url_overrides": {
+    "newtab": "newtab.html"
+  },
+  "icons": {
+    "16": "assets/icons/icon16.png",
+    "32": "assets/icons/icon32.png",
+    "48": "assets/icons/icon48.png",
+    "128": "assets/icons/icon128.png"
+  },
+  "key": "MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQDBgcDkbYKfMtQKmKd9FWYOsq0Xu8r74ZR+6kmVYvtoM9qn7lo2mK8ofFWsIcQDfathedyGy50E5lv0gleCgdo9CgIBCTOqjYtevsVA/LuRxGPDaT15Yz8MWkmEloC9j1mQD/qCiiKZhdMuJKLAmEHOsZ6XQMdQryIxVB8IiIEJVQIDAQAB"
+}
diff --git a/chrome/browser/resources/fast_start_hub/newtab.css b/chrome/browser/resources/fast_start_hub/newtab.css
new file mode 100644
index 0000000000000000000000000000000000000000..c83b7dde20ef5c798e986cd63655b0f7b844c4aa
--- /dev/null
+++ b/chrome/browser/resources/fast_start_hub/newtab.css
@@ -0,0 +1,323 @@
+:root {
+  --text: #f2f5f7;
+  --muted: #aeb8c1;
+  --panel: rgba(22, 27, 33, .82);
+  --panel-strong: rgba(18, 22, 27, .94);
+  --input: rgba(255,255,255,.07);
+  --border: rgba(255,255,255,.11);
+  --border-strong: rgba(255,255,255,.18);
+  --accent: #e9eef2;
+  --accent-text: #11161b;
+  --shadow: 0 18px 52px rgba(0,0,0,.28);
+  --focus: rgba(255,255,255,.75);
+}
+* { box-sizing: border-box; }
+html, body { min-height: 100%; margin: 0; }
+body { font-family: "Segoe UI Variable", "Segoe UI", system-ui, -apple-system, sans-serif; color: var(--text); background: #0c1014; overflow-x: hidden; color-scheme: dark; }
+body[data-theme="light"] {
+  color-scheme: light;
+  --text: #141b22;
+  --muted: #5f6d78;
+  --panel: rgba(255,255,255,.76);
+  --panel-strong: rgba(250,252,254,.94);
+  --input: rgba(20,31,42,.055);
+  --border: rgba(20,31,42,.10);
+  --border-strong: rgba(20,31,42,.17);
+  --accent: #161d23;
+  --accent-text: #fff;
+  --shadow: 0 18px 52px rgba(56,72,86,.16);
+  --focus: rgba(20,31,42,.62);
+  background: #f3f6f8;
+}
+body[data-theme="system"] { color-scheme: light dark; }
+@media (prefers-color-scheme: light) {
+  body[data-theme="system"] {
+    --text: #141b22; --muted: #5f6d78; --panel: rgba(255,255,255,.76); --panel-strong: rgba(250,252,254,.94);
+    --input: rgba(20,31,42,.055); --border: rgba(20,31,42,.10); --border-strong: rgba(20,31,42,.17);
+    --accent: #161d23; --accent-text: #fff; --shadow: 0 18px 52px rgba(56,72,86,.16); --focus: rgba(20,31,42,.62);
+  }
+}
+button, input, textarea, select { font: inherit; }
+button { border: 0; cursor: pointer; border-radius: 11px; padding: 10px 14px; background: var(--accent); color: var(--accent-text); font-weight: 600; }
+button:hover { filter: brightness(1.04); }
+button:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
+.secondary { background: rgba(127,127,127,.14); color: var(--text); border: 1px solid var(--border); }
+.text-button { padding: 0; background: transparent; color: var(--muted); border-radius: 4px; font-weight: 500; }
+.text-button:hover { color: var(--text); }
+.backdrop { position: fixed; inset: 0; z-index: 0; background-size: cover; background-position: center; transform: scale(1.012); }
+body[data-wallpaper="brand"][data-theme="dark"] .backdrop { background-image: url("assets/wallpapers/dark.png"); }
+body[data-wallpaper="brand"][data-theme="light"] .backdrop { background-image: url("assets/wallpapers/light.png"); }
+body[data-wallpaper="brand"][data-theme="system"] .backdrop { background-image: url("assets/wallpapers/dark.png"); }
+@media (prefers-color-scheme: light) { body[data-wallpaper="brand"][data-theme="system"] .backdrop { background-image: url("assets/wallpapers/light.png"); } }
+body[data-wallpaper="gradient"] .backdrop { background-image: radial-gradient(circle at 50% 20%, #28333d 0, #10161b 38%, #080b0e 100%); }
+body[data-wallpaper="gradient"][data-theme="light"] .backdrop { background-image: radial-gradient(circle at 50% 20%, #fff 0, #edf2f6 46%, #dfe7ed 100%); }
+body[data-wallpaper="plain"] .backdrop { background: #0d1115; }
+body[data-wallpaper="plain"][data-theme="light"] .backdrop { background: #eef2f5; }
+.scrim { position: fixed; inset: 0; z-index: 1; background: linear-gradient(180deg, rgba(6,9,12,.17), rgba(6,9,12,.34)); pointer-events: none; }
+body[data-theme="light"] .scrim { background: rgba(255,255,255,.05); }
+.topbar { position: relative; z-index: 3; display: flex; justify-content: space-between; align-items: center; padding: 16px 22px; }
+.brand-button { padding: 0; background: transparent; border-radius: 8px; }
+.brand-button img { display: block; width: 142px; max-height: 34px; object-fit: contain; object-position: left center; }
+.top-actions { display: flex; align-items: center; gap: 10px; }
+.save-state { color: var(--muted); font-size: 12px; opacity: .82; }
+.icon-button { width: 40px; height: 40px; padding: 0; font-size: 18px; background: rgba(18,22,27,.66); color: white; border: 1px solid rgba(255,255,255,.13); backdrop-filter: blur(14px); }
+body[data-theme="light"] .icon-button { background: rgba(255,255,255,.76); color: #17202a; border-color: rgba(22,30,40,.1); }
+.shell { position: relative; z-index: 2; width: min(1180px, calc(100% - 48px)); margin: 2.2vh auto 60px; }
+.hero { display: flex; justify-content: center; margin: 4vh 0 32px; }
+.search { display: grid; grid-template-columns: 28px 1fr auto auto; align-items: center; width: min(780px, 100%); padding: 7px 8px 7px 16px; border-radius: 22px; background: var(--panel-strong); border: 1px solid var(--border); box-shadow: var(--shadow); backdrop-filter: blur(24px); }
+.search-icon { font-size: 23px; opacity: .68; }
+.search input { width: 100%; background: transparent; color: var(--text); border: 0; outline: none; padding: 10px 8px; font-size: 16px; }
+.search-shortcut { color: var(--muted); border: 1px solid var(--border); background: rgba(127,127,127,.10); border-radius: 7px; padding: 4px 7px; font-size: 11px; font-family: inherit; margin-right: 6px; }
+.widget-grid { display: grid; grid-template-columns: repeat(12, minmax(0,1fr)); gap: 16px; align-items: stretch; grid-auto-flow: row; }
+.widget { min-height: 168px; height: 100%; padding: 18px; background: var(--panel); border: 1px solid var(--border); border-radius: 19px; box-shadow: var(--shadow); backdrop-filter: blur(19px); transition: transform .14s ease, border-color .14s ease, background .14s ease; }
+.widget:hover { border-color: var(--border-strong); }
+.widget.size-small { grid-column: span 3; }
+.widget.size-medium { grid-column: span 4; }
+.widget.size-large { grid-column: span 6; }
+.widget.size-full { grid-column: span 12; }
+.widget.dragging { opacity: .56; transform: scale(.985); }
+.widget.drag-over { border-color: rgba(255,255,255,.42); }
+.widget-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; font-weight: 650; margin-bottom: 15px; min-height: 30px; }
+.widget-actions { display: inline-flex; align-items: center; gap: 2px; margin: -5px -6px -5px 0; }
+.widget-drag-handle, .widget-menu-button { width: 30px; height: 30px; padding: 0; display: inline-grid; place-items: center; border-radius: 8px; background: transparent; color: var(--muted); border: 0; font-weight: 700; line-height: 1; }
+.widget-drag-handle { cursor: grab; font-size: 17px; }
+.widget-drag-handle:active { cursor: grabbing; }
+.widget-menu-button { font-size: 20px; }
+.widget-drag-handle:hover, .widget-menu-button:hover { background: rgba(127,127,127,.15); color: var(--text); }
+.muted { color: var(--muted); }
+.small { font-size: 12px; }
+.clock-time { font-size: clamp(34px, 4.2vw, 54px); font-weight: 280; letter-spacing: -2px; line-height: 1; margin-top: 12px; font-variant-numeric: tabular-nums; }
+.quick-links { display: grid; grid-template-columns: repeat(auto-fill, minmax(90px,1fr)); gap: 9px; }
+.quick-link { position: relative; display: flex; flex-direction: column; align-items: center; gap: 7px; padding: 10px 6px; color: var(--text); text-decoration: none; border-radius: 14px; }
+.quick-link:hover { background: rgba(127,127,127,.12); }
+.link-badge { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: rgba(127,127,127,.18); border: 1px solid var(--border); font-weight: 700; overflow: hidden; }
+.link-badge img { width: 22px; height: 22px; object-fit: contain; }
+.link-name { max-width: 98px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.link-remove { position: absolute; right: 2px; top: 2px; width: 22px; height: 22px; padding: 0; opacity: 0; background: rgba(0,0,0,.50); color: white; }
+.quick-link:hover .link-remove { opacity: 1; }
+.add-row { margin-top: 12px; }
+.compact-form { display: grid; grid-template-columns: 1fr auto; gap: 8px; }
+.compact-form.stacked { grid-template-columns: 1fr; }
+input, textarea, select { border: 1px solid var(--border); background: var(--input); color: var(--text); border-radius: 11px; outline: none; }
+input { padding: 10px 11px; }
+textarea { resize: vertical; width: 100%; min-height: 116px; padding: 11px; }
+select { padding: 8px 34px 8px 10px; background-color: #1b2127; color: #f2f5f7; color-scheme: dark; }
+select option { background-color: #1b2127; color: #f2f5f7; }
+body[data-theme="light"] select { background-color: #f8fafb; color: #141b22; color-scheme: light; }
+body[data-theme="light"] select option { background-color: #ffffff; color: #141b22; }
+@media (prefers-color-scheme: light) {
+  body[data-theme="system"] select { background-color: #f8fafb; color: #141b22; color-scheme: light; }
+  body[data-theme="system"] select option { background-color: #ffffff; color: #141b22; }
+}
+.task-list { list-style: none; margin: 12px 0 0; padding: 0; max-height: 220px; overflow: auto; }
